# ============================================================
#  templates/taskflow-compose.yml.j2 — Template Docker Compose
#
#  Gerado pelo Ansible durante o provisionamento da vm-nginx.
#  As variáveis são substituídas pelos valores do playbook.
#
#  DIFERENÇA em relação ao compose de desenvolvimento:
#  NÃO inclui o serviço 'db' — o PostgreSQL roda na vm-db
#  (VM separada), e a aplicação conecta via rede interna.
#  Isso documenta a comunicação externa entre VMs do TCC.
# ============================================================

services:

  # ------------------------------------------------------------
  # Aplicação Node.js (TaskFlow Backend + Servir Frontend)
  # Conecta ao PostgreSQL externo na vm-db via variáveis de ambiente
  # ------------------------------------------------------------
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: taskflow-app
    restart: unless-stopped
    environment:
      # Conexão com o banco PostgreSQL externo (vm-db)
      # db_server_ip é o IP real da vm-db, injetado pelo Ansible
      DB_HOST: "{{ db_server_ip }}"
      DB_PORT: "{{ taskflow_db_port }}"
      DB_USER: "{{ taskflow_db_user }}"
      DB_PASSWORD: "{{ taskflow_db_password }}"
      DB_NAME: "{{ taskflow_db_name }}"
      PORT: 3000
    expose:
      - "3000"

  # ------------------------------------------------------------
  # Nginx como Proxy Reverso
  # Recebe requisições HTTP na porta 80 e encaminha ao Node.js
  # Serve também como ponto de cache para arquivos estáticos
  # ------------------------------------------------------------
  nginx:
    image: nginx:alpine
    container_name: taskflow-nginx
    restart: unless-stopped
    ports:
      - "80:80"    # Expõe a aplicação na porta 80 da VM
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - app        # Aguarda o container app estar disponível
